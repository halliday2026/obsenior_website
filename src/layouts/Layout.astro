---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // normalize: always ends with /

const {
  title = 'Senior Concierge San Diego | OB Senior Concierge',
  description = 'Senior concierge, personal assistant, and senior transportation services in Carmel Valley, Rancho Bernardo, and North County San Diego. Call 858-722-1930.',
  ogImage = `${Astro.site}${base.replace(/^\//, '')}og-image.jpg`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  name: 'OB Senior Concierge',
  description: 'Non-medical senior concierge and lifestyle management services in North County San Diego. Personalized support including administrative assistance, scheduling, errands, transportation, and social visits — delivered by one consistent, trusted person.',
  url: 'https://obhelp.com',
  telephone: '858-722-1930',
  email: 'obpmservices@gmail.com',
  priceRange: '$$',
  founder: { '@type': 'Person', name: 'Donna O\'Brien' },
  areaServed: [
    { '@type': 'City', name: 'Carmel Valley' },
    { '@type': 'City', name: 'Rancho Bernardo' },
    { '@type': 'City', name: 'Del Mar' },
    { '@type': 'City', name: 'Solana Beach' },
    { '@type': 'City', name: 'Poway' },
    { '@type': 'City', name: '4S Ranch' },
    { '@type': 'City', name: 'Scripps Ranch' },
    { '@type': 'AdministrativeArea', name: 'North County San Diego' },
    { '@type': 'City', name: 'San Diego' },
  ],
  serviceType: [
    'Senior Concierge Services',
    'Personal Assistant for Seniors',
    'Senior Transportation Services',
    'Senior Lifestyle Management',
    'Administrative Support for Seniors',
    'Errand Services for Seniors',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Senior Concierge Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Administrative & Technology Support', description: 'Organizing paperwork, bills, and mail; help with online accounts, email, and everyday technology.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Scheduling & Coordination', description: 'Appointment scheduling and reminders, service coordination and planning, calendar management.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Personal Organization', description: 'Light organization of home and workspace, sorting files, belongings, and storage.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Senior Transportation', description: 'Rides to appointments and errands throughout North County San Diego, accompaniment as needed.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Concierge Assistance', description: 'Errands and local tasks, friendly social visits, meal prep reminders, flexible support.' } },
    ],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f3a52" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <!-- TODO: Replace with actual 1200×630 OG image before launch -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="OB Senior Concierge" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Cormorant Garamond (serif headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600&display=swap"
    />

    <!-- Favicon (SVG monogram — works in all modern browsers) -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-RyNmibZQDlq_nF09Tm-R7.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
